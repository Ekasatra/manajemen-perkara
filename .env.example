# Supabase (isi dari dashboard project ekasatra-staging)
# NEXT_PUBLIC_* terkirim ke browser — jangan taruh secret di sana.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Seed Admin pertama (hanya dipakai `pnpm --filter @ekasatra/db seed`; password ≥ 8 karakter)
SEED_ADMIN_EMAIL=eko.prasetyo@ekasatra.com
SEED_ADMIN_PASSWORD=qwerty
SEED_ADMIN_NAME=Eko Prasetyo
# Opsional: satu-satunya Superadmin (hak hapus). Jika akun sudah ada, rolenya dinaikkan.
SEED_SUPERADMIN_EMAIL=tjahyo@ekasatra.com
SEED_SUPERADMIN_PASSWORD=peneliti.ekasatra.law
SEED_SUPERADMIN_NAME=Tjahyo

# Email — SMTP Gmail Workspace (W4 R2, pengirim utama)
# App Password: isi sendiri di Vercel; JANGAN commit nilai asli.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EKASATRA <info@ekasatra.com>"

# Email — Resend (fallback lama, opsional)
RESEND_API_KEY=
# MAIL_FROM sudah dipakai SMTP di atas; Resend pakai RESEND_FROM_EMAIL bila berbeda.
RESEND_FROM_EMAIL=

# Cron (Vercel Cron mengirim header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Aplikasi
APP_URL=http://localhost:3000
