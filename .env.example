# Supabase (isi dari dashboard project ekasatra-staging)
# NEXT_PUBLIC_* terkirim ke browser — jangan taruh secret di sana.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Seed Admin pertama (hanya dipakai `pnpm --filter @ekasatra/db seed`; password ≥ 8 karakter)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Cron (Vercel Cron mengirim header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Aplikasi
APP_URL=http://localhost:3000
