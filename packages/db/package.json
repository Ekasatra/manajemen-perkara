{
  "name": "@ekasatra/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "verify:local": "bash ../../supabase/local/verify.sh"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
